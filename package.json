{
  "name": "gestion-finanzas",
  "version": "1.0.0",
  "description": "Aplicación de gestión de gastos e ingresos",
  "main": "electron/main-working.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"cd backend && npm run dev\" \"cd frontend && npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build:frontend": "cd frontend && npm run build",
    "build:win": "npm run build:frontend && electron-builder --win",
    "build:all": "npm run build:frontend && electron-builder -mwl"
  },
  "dependencies": {
    "express": "^5.2.1",
    "cors": "^2.8.6",
    "lowdb": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.gestionfinanzas.app",
    "productName": "Gestión de Finanzas",
    "directories": {
      "output": "C:\\Users\\Mateo\\Desktop\\Instaladores"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
